# Maintainer: Eisa Ahmed <eahmed234@gmail.com>
#
# smckbd - exposes the Intel-Mac keyboard backlight as smc::kbd_backlight on
# kernels that moved from applesmc to the macsmc stack (Linux 7.3+).

pkgname=smckbd-dkms-git
pkgver=0
pkgrel=1
pkgdesc="DKMS module exposing the keyboard backlight as smc::kbd_backlight on macsmc kernels"
arch=('x86_64')
url="https://github.com/eahmed234/smckbd"
license=('GPL-2.0-only')
depends=('dkms' 'glibc')
makedepends=('git')
provides=('smckbd')
conflicts=('smckbd-dkms')
install="$pkgname.install"

_srcname=smckbd
source=("$_srcname::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "$_srcname"
  printf 'r%s.%s' \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_srcname"
  make keys
}

package() {
  cd "$_srcname"
  local _dst="$pkgdir/usr/src/smckbd-$pkgver"

  install -d "$_dst"
  install -m644 smckbd.c Makefile "$_dst/"

  cat > "$_dst/dkms.conf" <<'EOF'
PACKAGE_NAME="smckbd"
PACKAGE_VERSION="@PKGVER@"
MAKE[0]="make KVER=${kernelver} KBUILD_DIR=${kernel_source_dir}"
BUILT_MODULE_NAME[0]="smckbd"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates/dkms"
AUTOINSTALL="yes"
# macsmc only exists from 7.3 on; older kernels use applesmc's LED.
BUILD_EXCLUSIVE_KERNEL_MIN="7.3"
EOF
  sed -i "s/@PKGVER@/$pkgver/" "$_dst/dkms.conf"

  install -Dm755 smckbd-keys "$pkgdir/usr/bin/smckbd-keys"
  install -Dm644 smckbd.service \
    "$pkgdir/usr/lib/systemd/system/smckbd.service"
  install -Dm644 smckbd-keys.service \
    "$pkgdir/usr/lib/systemd/system/smckbd-keys.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
